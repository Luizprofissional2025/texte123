# Copie este arquivo para ".env.local" e preencha os valores reais.
# ".env.local" NUNCA deve ser commitado no Git (já está no .gitignore).

# --- Banco de dados (Vercel Postgres) -----------------------------------
# Criado automaticamente quando você conecta o banco "Postgres" gratuito
# da Vercel ao projeto (Storage > Create Database > Postgres).
# A Vercel preenche essa variável sozinha em produção; localmente, copie
# o valor a partir do painel do projeto em "Settings > Environment Variables".
POSTGRES_URL="postgres://usuario:senha@host:5432/banco?sslmode=require"

# --- WhatsApp -------------------------------------------------------------
# Número completo com código do país e DDD, apenas dígitos (sem +, espaços
# ou traços). Exposto ao navegador (por isso o prefixo NEXT_PUBLIC_) porque
# é usado para montar os links "wa.me" nos botões.
NEXT_PUBLIC_WHATSAPP_NUMBER="5521972794004"

# --- Segurança do formulário de leads --------------------------------------
# Domínio oficial do site em produção. A API de leads recusa qualquer
# requisição cuja origem não bata com este valor (proteção extra além do
# CORS padrão do navegador). Em desenvolvimento local, use http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://imperadorautognv.com.br"

# --- Rate limiting (opcional, mas recomendado em produção) -----------------
# Se você conectar o add-on gratuito "Vercel KV" ao projeto, essas variáveis
# são preenchidas automaticamente e o rate limit passa a valer entre todas
# as instâncias do servidor (não só na memória de uma única execução).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
